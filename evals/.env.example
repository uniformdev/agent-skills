# API keys (choose based on the agent you are running)
# For vercel-ai-gateway agents, and to enable failure classification:
AI_GATEWAY_API_KEY=your-ai-gateway-api-key

# For running Claude Code directly against the Anthropic API:
# ANTHROPIC_API_KEY=sk-ant-...

# Sandbox access - required (choose ONE of the options below)
# Option 1: Vercel token (local development) - https://vercel.com/account/tokens
# Sandbox usage is attributed to the team and project you point these at. They are
# identifiers, not secrets.
VERCEL_TOKEN=your-vercel-token
VERCEL_TEAM_ID=team_your-team-id
VERCEL_PROJECT_ID=prj_your-project-id

# Option 2: OIDC token (CI pipelines) - provided by the Vercel CI integration
# VERCEL_OIDC_TOKEN=your-oidc-token

# Alternative: run Docker locally and set sandbox: 'docker' in the experiment config

# For the GitHub Copilot arms (eval:mesh:copilot) - Copilot CLI does not run through
# the AI Gateway, so it needs its own credential. This must be a fine-grained PAT owned
# by a PERSONAL account with the "Copilot Requests" permission; a GitHub Actions
# installation token (secrets.GITHUB_TOKEN) is rejected by the endpoint.
# COPILOT_GITHUB_TOKEN=github_pat_...
